          ],
          "controls": [
            "Release strategy configuration",
            "Value-based approval limits",
            "SoD: PO creator != PO approver"
          ]
        },
        {
          "order": 5,
          "name": "Goods Receipt",
          "tcodes": [
            "MIGO",
            "MB01",
            "MB31"
          ],
          "description": "Warehouse receives goods and posts goods receipt against PO.",
          "risks": [
            "Receipt without delivery",
            "Quantity manipulation",
