            "Duplicate invoice check",
            "SoD: GR poster != invoice poster"
          ]
        },
        {
          "order": 7,
          "name": "Payment Processing",
          "tcodes": [
            "F110",
            "F-53",
            "F-58"
          ],
          "description": "Payment run executed to pay approved vendor invoices.",
          "risks": [
            "Payment to fictitious vendor",
            "Duplicate payments",
            "Unauthorized bank details change"
