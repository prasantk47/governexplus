            "Tolerance limits on over-delivery",
            "Physical inspection requirement"
          ]
        },
        {
          "order": 6,
          "name": "Invoice Verification",
          "tcodes": [
            "MIRO",
            "MIR7",
            "MIR4"
          ],
          "description": "Accounts payable matches vendor invoice against PO and GR (3-way match).",
          "risks": [
            "Invoice without GR",
            "Duplicate invoices",
            "Price discrepancies",
            "Fraudulent invoices"
          ],
          "controls": [
