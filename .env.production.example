# =============================================================================
# Governex+ Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all REQUIRED values before deploying.
#
# REQUIRED variables are marked with [REQUIRED].
# Optional variables have sensible defaults shown.
# =============================================================================

# ---------------------------------------------------------------------------
# Core Application
# ---------------------------------------------------------------------------
APP_ENV=production                          # [REQUIRED] Must be "production"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/governexplus  # [REQUIRED]

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=                                 # [REQUIRED] 64-char hex string
ACCESS_TOKEN_EXPIRE_MINUTES=30              # Token lifetime (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=7                 # Refresh token lifetime (default: 7)
SESSION_TIMEOUT_MINUTES=30                  # Idle session timeout (default: 30)
MAX_FAILED_LOGINS=5                         # Account lockout threshold (default: 5)
ACCOUNT_LOCKOUT_MINUTES=30                  # Lockout duration (default: 30)

# ---------------------------------------------------------------------------
# CORS — Allowed frontend origins (comma-separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://app.governexplus.com   # [REQUIRED] Your frontend URL(s)

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------
HTTPS_ENABLED=true                          # Enable HTTPS redirect middleware

# ---------------------------------------------------------------------------
# Multi-Tenant
# ---------------------------------------------------------------------------
DEFAULT_TENANT_ID=tenant_default            # Default tenant for single-tenant deploys

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=60/minute                # Global rate limit
RATE_LIMIT_AUTH=10/minute                   # Auth endpoint rate limit
RATE_LIMIT_STORAGE=redis://localhost:6379   # [RECOMMENDED] Redis for multi-instance

# ---------------------------------------------------------------------------
# SAP Connectivity
# ---------------------------------------------------------------------------
SAP_CONNECTOR_TYPE=sap_mock                 # Use "sap_rfc" for real SAP connection
SAP_SYSTEM_NAME=SAP_PRD                    # SAP system identifier
SAP_HOST=                                   # SAP application server hostname
SAP_CLIENT=100                              # SAP client number
# SAP_ASHOST=                               # SAP AS host (for RFC)
# SAP_SYSNR=                                # SAP system number (for RFC)
# SAP_USER=                                 # SAP RFC user
# SAP_PASSWORD=                             # SAP RFC password

# ---------------------------------------------------------------------------
# Email Notifications (SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=                                  # SMTP server hostname
SMTP_PORT=587                               # SMTP port (587 for TLS)
SMTP_USER=                                  # SMTP username
SMTP_PASSWORD=                              # SMTP password
SMTP_FROM=noreply@governexplus.com          # Sender email address
SMTP_USE_TLS=true                           # Use TLS encryption

# ---------------------------------------------------------------------------
# Slack Notifications (optional)
# ---------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=                        # Incoming webhook URL
# SLACK_BOT_TOKEN=                          # Bot token for channel posting
# SLACK_DEFAULT_CHANNEL=#grc-alerts         # Default notification channel

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                              # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                             # "json" for production, "console" for dev
# LOG_FILE=/var/log/governexplus/app.log    # Optional: file output for Filebeat/Fluentd

# ---------------------------------------------------------------------------
# Audit Evidence Signing (optional)
# ---------------------------------------------------------------------------
# AUDIT_SIGNING_KEY=                        # HMAC key for evidence signing

# ---------------------------------------------------------------------------
# Database Migrations
# ---------------------------------------------------------------------------
AUTO_MIGRATE=true                           # Run Alembic migrations on startup

# ---------------------------------------------------------------------------
# Seed Data
# ---------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=                      # Initial admin password (change after first login)
