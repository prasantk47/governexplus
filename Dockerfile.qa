# QA-only Dockerfile — no SAP NW RFC SDK required
# SAP connector runs in mock mode (SAP_CONNECTOR_MODE=mock)
# pyrfc is NOT installed; the mock connector intercepts all SAP calls
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies (no pyrfc)
COPY requirements.qa.txt .
RUN pip install --no-cache-dir -r requirements.qa.txt || \
    pip install --no-cache-dir fastapi uvicorn sqlalchemy pydantic pyyaml \
        python-dotenv python-jose passlib httpx python-multipart aiohttp \
        structlog networkx pandas numpy scikit-learn alembic psycopg2-binary \
        slowapi bcrypt pydantic-settings

# Copy application code
COPY . .

EXPOSE 9000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "9000"]
